{
  "name": "queimadasINPE",
  "max_concurrent_runs": 1,
  "queue": { "enabled": true },
  "tasks": [
    {
      "task_key": "bronze",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<SEU_EMAIL>/Camada Bronze - ingestao raw",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "silver",
      "depends_on": [{ "task_key": "bronze" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<SEU_EMAIL>/Camada Silver - limpeza e qualidade de dados",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "gold",
      "depends_on": [{ "task_key": "silver" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<SEU_EMAIL>/Camada Gold - Armazenamento",
        "source": "WORKSPACE"
      }
    }
  ],
  "trigger": {
    "pause_status": "UNPAUSED",
    "file_arrival": {
      "url": "/Volumes/inpe/bronze/arquivo/",
      "min_time_between_triggers_seconds": 60,
      "wait_after_last_change_seconds": 60
    }
  }
}
